<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Mini_Request_Management_Portal.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Mini Request Management Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server" EnableCdn="true">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <!-- Navbar -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/">Mini Request Portal
                </a>
                <button type="button" class="navbar-toggler"
                    data-toggle="collapse"
                    data-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">

                    <!-- Left nav links -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/">Home</a>
                        </li>
                    </ul>

                    <!-- Right side: user info + switch role button -->
                    <ul class="navbar-nav align-items-center ml-auto">
                        <li class="nav-item d-flex align-items-center mr-2">
                            <span class="text-white-50 small mr-1">Role:</span>
                            <asp:Label ID="lblUserRole" runat="server"
                                CssClass="badge badge-primary mr-2" />
                            <span class="text-white small ml-2">
                                <asp:Label ID="lblUserName" runat="server" />
                            </span>
                        </li>
                        <li class="nav-item">
                            <asp:Button ID="btnSwitchRole" runat="server"
                                Text="Switch Role"
                                CssClass="btn btn-outline-light btn-sm"
                                OnClick="btnSwitchRole_Click" />
                        </li>
                    </ul>

                </div>
            </div>
        </nav>

        <!-- Main content -->
        <div class="container mt-4" style="padding-bottom: 80px;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <!-- Footer -->
        <footer class="bg-dark text-white text-center py-3" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000;">
            <p class="mb-0">&copy; <%: DateTime.Now.Year %> Mini Request Management Portal</p>
        </footer>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
